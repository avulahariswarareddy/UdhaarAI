# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Judge auto-login (/api/auth/judge) ----
# SERVER ONLY. A dedicated Supabase account the "Enter Judge Workspace"
# button on the login page signs into automatically — created on first use
# via the admin API if it doesn't exist yet, then seeded with demo data.
# The email never needs to receive mail; pick any address, real or not.
JUDGE_ACCOUNT_EMAIL=judge@udhaarai.demo
JUDGE_ACCOUNT_PASSWORD=a-long-random-string-you-generate-once

# ---- Gemini (aistudio.google.com/apikey) ----
# SERVER ONLY. This key is used exclusively inside /api routes.
GEMINI_API_KEY=your-gemini-api-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
